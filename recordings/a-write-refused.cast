[15.004268, "o", "Linked 01a1f735-486e-7000-8f74-985623b2a17b -refuses-a-write→ src/billing\r\n  src/billing covers 0 of 4 file(s) counted in the working tree; not counted: .git, .mnema.\r\n  Files on disk, not edits: a directory nobody touches counts the same as a busy one.\r\n  Landed in the public tree: committed with the repository, so it reaches every clone.\r\n"]
